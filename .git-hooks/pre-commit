#!/bin/bash
#
# Pre-commit hook to prevent committing sensitive files
# 
# Installation:
#   chmod +x .git-hooks/pre-commit
#   cp .git-hooks/pre-commit .git/hooks/pre-commit
#
# Or use: git config core.hooksPath .git-hooks

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Files that should never be committed
SENSITIVE_FILES=(
    "keys.py"
    ".env"
    ".env.local"
    "secrets.json"
    "config.local.json"
)

# Patterns to search for in committed files
SENSITIVE_PATTERNS=(
    "sk-[a-zA-Z0-9]{48}"  # OpenAI API key pattern
    "OPENAI_API_KEY.*=.*['\"]sk-"
    "DEEPSEEK_API_KEY.*=.*['\"]sk-"
    "VOLCENGINE_API_KEY.*=.*['\"]"
    "ANTHROPIC_API_KEY.*=.*['\"]sk-ant-"
    "password.*=.*['\"][^'\"]{8,}"
)

echo "🔒 Running security checks..."

# Check for sensitive files
for file in "${SENSITIVE_FILES[@]}"; do
    if git diff --cached --name-only | grep -q "^${file}$"; then
        echo -e "${RED}❌ ERROR: Attempting to commit sensitive file: ${file}${NC}"
        echo -e "${YELLOW}This file contains API keys and should never be committed!${NC}"
        echo ""
        echo "To fix this:"
        echo "  git reset HEAD ${file}"
        echo ""
        exit 1
    fi
done

# Check for sensitive patterns in staged files
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if git diff --cached | grep -qE "${pattern}"; then
        echo -e "${RED}❌ ERROR: Potential API key or secret detected in staged changes!${NC}"
        echo -e "${YELLOW}Pattern matched: ${pattern}${NC}"
        echo ""
        echo "Please review your changes and remove any sensitive information."
        echo "Use environment variables or configuration files instead."
        echo ""
        exit 1
    fi
done

# Check if keys.py exists and is not in .gitignore
if [ -f "keys.py" ]; then
    if ! git check-ignore -q keys.py; then
        echo -e "${RED}❌ ERROR: keys.py exists but is not in .gitignore!${NC}"
        echo -e "${YELLOW}Adding keys.py to .gitignore...${NC}"
        echo "keys.py" >> .gitignore
        echo ""
        echo "Please commit the updated .gitignore file."
        exit 1
    fi
fi

echo "✅ Security checks passed!"
exit 0
