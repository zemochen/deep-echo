{
  "audio": {
    "use_api_mode": false,
    "whisper_model": "tiny.en",
    "whisper_model_path": null,
    "record_timeout": 3,
    "phrase_timeout": 3.05,
    "energy_threshold": 1000,
    "max_phrases": 10,
    "processing_interval": 0.1
  },
  "ai_provider": {
    "provider_type": "deepseek",
    "api_key": "your-deepseek-api-key-here",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "timeout": 30,
    "max_retries": 3,
    "response_interval": 5
  },
  "ui": {
    "use_new_ui": true,
    "update_interval": 0.3,
    "window_width": 1200,
    "window_height": 800,
    "theme": "dark"
  },
  "logging": {
    "level": "INFO",
    "file": "deepecho.log",
    "max_size": "10MB",
    "console_enabled": true,
    "backup_count": 5
  },
  "performance": {
    "enable_optimization": true,
    "memory_limit": "1GB",
    "cpu_limit": 80,
    "queue_size_limit": 1000
  }
}
